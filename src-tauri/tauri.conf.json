{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plugin Hub",
  "version": "1.0.2",
  "identifier": "dev.kimmj1234.pluginhub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Plugin Hub",
        "visible": false,
        "width": 1240,
        "height": 820,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Claude Code 플러그인 관리",
    "createUpdaterArtifacts": true,
    "publisher": "kimmj1234",
    "copyright": "Copyright (c) 2026 김명제. MIT License.",
    "license": "MIT",
    "homepage": "https://github.com/kimmj1234/plugin-hub",
    "longDescription": "Claude Code와 Claude 앱의 플러그인을 한곳에서 찾고, 설치하고, 정리하고, 켜고 끄는 데스크톱 앱입니다.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "resources": {
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../LICENSE": "LICENSE.txt"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFODg0QjFENEUxMkJBRTUKUldUbHVoSk9IVXVJSHRpRi9CanRlaWg2Sk0wYlQvbk0wSVZEUjkyMktUbVEzQjBuTGNRN3Vmc1EK",
      "endpoints": [
        "https://github.com/kimmj1234/plugin-hub/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
